# Browser-visible (safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only (never prefix with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=replace-me
# 64+ random characters; signs PIN access tokens and rate-limit fingerprints
EVENT_ACCESS_SECRET=replace-with-long-random-string

# Android build: the published web app URL the APK loads
VELORA_APP_URL=https://your-app.example.com
